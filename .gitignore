# ---------------------------------------------------------------
# 依赖与工具链
# ---------------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---------------------------------------------------------------
# 构建产物（源码仓库不放产物，安装包单独发布）
# ---------------------------------------------------------------
build/
dist/
web-build/
web-dist/
release-*/
*.bundle.js
*.jsbundle
*.tsbuildinfo
*.blockmap
builder-debug.yml
.bundle/

# ---------------------------------------------------------------
# 运行期固定缓存目录
#   打包版在安装目录、开发版在项目根，均不应入库
# ---------------------------------------------------------------
/FlyMusicCache/

# ---------------------------------------------------------------
# 本地开发 / 调试临时文件（不入库，也不发布）
# ---------------------------------------------------------------
.tmp/
tmp/
*.log
npm-debug.log*
yarn-error.log*
.metro-health-check*
.eslintcache
.env
.env.*

# ---------------------------------------------------------------
# 工作记录、内部资料与历史设计稿（仅本地留存）
# ---------------------------------------------------------------
.workbuddy/
docs/
UI/
preview/

# ---------------------------------------------------------------
# 平台工程产物
# ---------------------------------------------------------------
# 工程只保留 Android + Web(Electron) 两个平台，iOS 工程（ios/、Gemfile、
# CocoaPods）已整体移除，这里不再保留对应忽略项。

# Android
.gradle/
.idea/
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
keystore.properties

# ---------------------------------------------------------------
# 系统与编辑器
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.VSCodeCounter/

# ---------------------------------------------------------------
# 测试覆盖率
# ---------------------------------------------------------------
/coverage
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# ---------------------------------------------------------------
# 构建入口脚本必须纳管，scripts/ 下的临时脚本不入库
# ---------------------------------------------------------------
scripts/*
!scripts/build-web.js
!scripts/generate-desktop-icon.py
!scripts/publish-win.js
